        <file alias="backgammon-32.png">../images/backgammon-32.png</file>
        <file alias="roll.png">../images/roll.png</file>
        <file alias="undo.png">../images/undo.png</file>
        <file alias="confirm.png">../images/confirm.png</file>
    </qresource>
</RCC>
